generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                   String   @id
  onboardingGoals      String[] @default([])
  lifeStage            String?
  onboardingCompleted  Boolean  @default(false)
  tourCompleted        Boolean  @default(false)
  notificationsEnabled Boolean  @default(true)
  openaiApiKey         String?
  firebaseUid          String?  @unique
  email                String?
  phoneNumber          String?
  displayName          String?
  authProvider         String?
  createdAt            DateTime @default(now())

  // net worth: manual inputs (no live account-aggregation integration)
  bankBalance      Float?
  otherInvestments Float?
  epfBalance       Float?

  // round-up savings
  roundUpEnabled   Boolean @default(false)
  roundUpIncrement Int     @default(10)
  roundUpGoalId    String?

  // app lock
  appLockEnabled Boolean @default(false)
  appLockPinHash String?

  // language preference
  language String @default("en")

  // post-login personalization
  preferredName String?
  age           Int?

  // Gmail auto-import
  gmailConnected       Boolean   @default(false)
  gmailEmail           String?
  gmailRefreshTokenEnc String?
  gmailLastSyncAt      DateTime?

  transactions      Transaction[]
  groups            Group[]
  budgets           Budget[]
  goals             Goal[]
  creditCards       CreditCard[]
  loans             Loan[]
  insurancePolicies InsurancePolicy[]
  insuranceDocuments InsuranceDocument[]
  subscriptions     Subscription[]
  goldHoldings      GoldHolding[]
  gmailImports      GmailImportRecord[]
  coupons           Coupon[]
}

model Coupon {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  merchant    String?
  code        String?
  description String?
  expiresAt   DateTime?
  isRedeemed  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId, expiresAt])
}

model GmailImportRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  messageId String
  createdAt DateTime @default(now())

  @@unique([userId, messageId])
}

model CreditCard {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  name                String
  bank                String?
  last4               String?
  network             String?
  kind                String   @default("Credit")
  statementDay        Int?
  dueDay              Int?
  currentDue          Float    @default(0)
  rewardPointsBalance Int?
  cashbackYtd         Float?
  createdAt           DateTime @default(now())

  transactions Transaction[]

  @@index([userId])
}

model Loan {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  name                 String
  lender               String?
  principal            Float
  interestRate         Float
  tenureMonths         Int
  emiAmount            Float
  startDate            DateTime
  dueDay               Int
  outstandingPrincipal Float
  createdAt            DateTime @default(now())

  @@index([userId])
}

model InsurancePolicy {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  type            String
  provider        String?
  policyName      String
  premiumAmount   Float
  frequency       String
  nextRenewalDate DateTime
  createdAt       DateTime @default(now())

  @@index([userId])
}

model InsuranceDocument {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fileName      String
  type          String
  subType       String?
  provider      String?
  policyName    String?
  sumInsured    Float?
  premiumAmount Float?
  frequency     String?
  rawText       String
  summary       Json
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  name            String
  amount          Float
  cycle           String
  category        String?
  nextRenewalDate DateTime
  source          String   @default("manual")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
}

model GoldHolding {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String
  grams         Float
  purchasePrice Float
  purchaseDate  DateTime
  currentValue  Float
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  amount         Float
  description    String
  category       String
  paymentMode    String
  cardId         String?
  card           CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  date           DateTime    @default(now())
  source         String      @default("manual")
  roundUpClaimed Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([userId, date])
  @@index([cardId])
}

model Group {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  type         String
  defaultSplit String   @default("Equal")
  isOneTime    Boolean  @default(false)
  createdAt    DateTime @default(now())

  members     GroupMember[]
  expenses    GroupExpense[]
  settlements Settlement[]

  @@index([userId])
}

model GroupMember {
  id            String    @id @default(cuid())
  groupId       String
  group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  isCurrentUser Boolean   @default(false)
  removedAt     DateTime?
  createdAt     DateTime  @default(now())

  paidExpenses    GroupExpense[] @relation("PaidBy")
  splits          ExpenseSplit[]
  settlementsFrom Settlement[]   @relation("SettleFrom")
  settlementsTo   Settlement[]   @relation("SettleTo")

  @@index([groupId])
}

model GroupExpense {
  id             String      @id @default(cuid())
  groupId        String
  group          Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description    String
  totalAmount    Float
  paidByMemberId String
  paidByMember   GroupMember @relation("PaidBy", fields: [paidByMemberId], references: [id], onDelete: Cascade)
  splitType      String      @default("Equal")
  itemsBreakdown Json?
  createdAt      DateTime    @default(now())

  splits ExpenseSplit[]

  @@index([groupId])
}

model ExpenseSplit {
  id             String       @id @default(cuid())
  groupExpenseId String
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  memberId       String
  member         GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareAmount    Float

  @@index([groupExpenseId])
}

model Settlement {
  id           String      @id @default(cuid())
  groupId      String
  group        Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMemberId String
  fromMember   GroupMember @relation("SettleFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMemberId   String
  toMember     GroupMember @relation("SettleTo", fields: [toMemberId], references: [id], onDelete: Cascade)
  amount       Float
  note         String?
  createdAt    DateTime    @default(now())

  @@index([groupId])
}

model Budget {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  type           String
  category       String?
  amount         Float
  alertThreshold Int       @default(80)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  type         String
  name         String
  targetAmount Float
  targetDate   DateTime?
  createdAt    DateTime  @default(now())

  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Float
  createdAt DateTime @default(now())

  @@index([goalId])
}
